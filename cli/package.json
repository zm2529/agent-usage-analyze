{
  "name": "agent-usage-analyze",
  "version": "0.1.6",
  "description": "Local-first usage, behavior, and improvement analytics for coding agents",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./db/client": "./dist/db/client.js",
    "./db/queue": "./dist/db/queue.js",
    "./db/read": "./dist/db/read.js",
    "./db/write": "./dist/db/write.js",
    "./db/schema": "./dist/db/schema.js",
    "./canonical/ingestion": "./dist/canonical/ingestion.js",
    "./canonical/codex-rollout": "./dist/canonical/codex-rollout.js",
    "./canonical/tasks": "./dist/canonical/tasks.js",
    "./canonical/patterns": "./dist/canonical/patterns.js",
    "./canonical/deliveries": "./dist/canonical/deliveries.js",
    "./canonical/buildermark-gate": "./dist/canonical/buildermark-gate.js",
    "./canonical/git-ai-gate": "./dist/canonical/git-ai-gate.js",
    "./canonical/semantic-analysis": "./dist/canonical/semantic-analysis.js",
    "./canonical/scorecards": "./dist/canonical/scorecards.js",
    "./canonical/observer-overhead": "./dist/canonical/observer-overhead.js",
    "./canonical/advisory": "./dist/canonical/advisory.js",
    "./canonical/sanitized-export": "./dist/canonical/sanitized-export.js",
    "./canonical/session-titles": "./dist/canonical/session-titles.js",
    "./db/product-migration": "./dist/db/product-migration.js",
    "./db/local-data-lifecycle": "./dist/db/local-data-lifecycle.js",
    "./sidecars/git-ai-manager": "./dist/sidecars/git-ai-manager.js",
    "./types": "./dist/types.js",
    "./utils/config": "./dist/utils/config.js",
    "./utils/codex-hooks": "./dist/utils/codex-hooks.js",
    "./utils/browser": "./dist/utils/browser.js",
    "./utils/update-service": "./dist/utils/update-service.js",
    "./constants/llm-providers": "./dist/constants/llm-providers.js",
    "./utils/pricing": "./dist/utils/pricing.js",
    "./utils/telemetry": "./dist/utils/telemetry.js",
    "./analysis/prompts": "./dist/analysis/prompts.js",
    "./analysis/prompt-types": "./dist/analysis/prompt-types.js",
    "./analysis/prompt-constants": "./dist/analysis/prompt-constants.js",
    "./analysis/message-format": "./dist/analysis/message-format.js",
    "./analysis/analysis-eligibility": "./dist/analysis/analysis-eligibility.js",
    "./analysis/response-parsers": "./dist/analysis/response-parsers.js",
    "./analysis/normalize-utils": "./dist/analysis/normalize-utils.js",
    "./analysis/friction-normalize": "./dist/analysis/friction-normalize.js",
    "./analysis/pattern-normalize": "./dist/analysis/pattern-normalize.js",
    "./analysis/prompt-quality-normalize": "./dist/analysis/prompt-quality-normalize.js",
    "./analysis/runner-types": "./dist/analysis/runner-types.js",
    "./analysis/native-runner": "./dist/analysis/native-runner.js",
    "./analysis/codex-native-runner": "./dist/analysis/codex-native-runner.js",
    "./analysis/knowledge-research": "./dist/analysis/knowledge-research.js",
    "./analysis/improvement-tracking": "./dist/analysis/improvement-tracking.js",
    "./analysis/analysis-db": "./dist/analysis/analysis-db.js",
    "./analysis/analysis-usage-db": "./dist/analysis/analysis-usage-db.js",
    "./analysis/analysis-run-db": "./dist/analysis/analysis-run-db.js",
    "./analysis/behavior-report": "./dist/analysis/behavior-report.js",
    "./analysis/behavior-report-scheduler": "./dist/analysis/behavior-report-scheduler.js",
    "./analysis/skill-usage": "./dist/analysis/skill-usage.js",
    "./analysis/provider-runner": "./dist/analysis/provider-runner.js",
    "./analysis/execution-policy": "./dist/analysis/execution-policy.js",
    "./analysis/automatic-status": "./dist/analysis/automatic-status.js",
    "./analysis/codex-account-usage": "./dist/analysis/codex-account-usage.js",
    "./analysis/runner-factory": "./dist/analysis/runner-factory.js",
    "./analysis/history-backfill": "./dist/analysis/history-backfill.js",
    "./analysis/settled-frontier": "./dist/analysis/settled-frontier.js",
    "./analysis/settled-scheduler": "./dist/analysis/settled-scheduler.js",
    "./analysis/codex-source-locator": "./dist/analysis/codex-source-locator.js",
    "./analysis/ingestion-log": "./dist/analysis/ingestion-log.js",
    "./commands/insights": "./dist/commands/insights.js",
    "./commands/sync": "./dist/commands/sync.js",
    "./commands/import-codex": "./dist/commands/import-codex.js",
    "./analysis/schemas/session-analysis.json": "./dist/analysis/schemas/session-analysis.json",
    "./analysis/schemas/prompt-quality.json": "./dist/analysis/schemas/prompt-quality.json"
  },
  "bin": {
    "agent-usage-analyze": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const{cpSync,mkdirSync}=require('fs');mkdirSync('dist/analysis/schemas',{recursive:true});cpSync('src/analysis/schemas/session-analysis.json','dist/analysis/schemas/session-analysis.json');cpSync('src/analysis/schemas/prompt-quality.json','dist/analysis/schemas/prompt-quality.json');\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepack": "pnpm --dir .. build && pnpm --dir .. package:prepare",
    "postpack": "pnpm --dir .. package:clean"
  },
  "files": [
    "dist",
    "vendor",
    "dashboard-dist",
    "server-dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "coding-agent",
    "codex",
    "claude-code",
    "cursor",
    "github-copilot",
    "developer-productivity",
    "insights",
    "analytics",
    "sqlite",
    "local-first"
  ],
  "author": "Agent Usage Analyzer contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zm2529/agent-usage-analyze.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/zm2529/agent-usage-analyze#readme",
  "bugs": {
    "url": "https://github.com/zm2529/agent-usage-analyze/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "hono": "^4.7.4",
    "inquirer": "^12.6.1",
    "ora": "^8.2.0",
    "jsonrepair": "^3.13.2",
    "posthog-node": "^4.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3"
  }
}
